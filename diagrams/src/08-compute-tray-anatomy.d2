# Layer 08: anatomy of one NVL72 compute tray (GB300 generation, with Vera Rubin differences).
# Original schematic drawn by this repo from public specifications (NVIDIA DGX GB200 user guide,
# NVIDIA NVL72 enterprise reference architecture, GB300 NVL72 product page, CES 2026 Vera Rubin
# coverage). Not to scale and not traced from any vendor image.
direction: down

title: "Anatomy of one NVL72 compute tray (schematic, 1U, top view)" {
  near: top-center
  shape: text
  style.font-size: 26
  style.bold: true
}

tray: "" {
  style.opacity: 0
  grid-rows: 3
  grid-gap: 14

  rear: "REAR EDGE - blind-mate connectors into the rack" {
    style.fill: "#F7F7F4"
    style.stroke: "#52514E"
    style.font-size: 19
    grid-columns: 3
    grid-gap: 12
    nvl: "NVLink connectors\n4 GPUs × 18 NVLink 5 links\n= 1.8 TB/s per GPU into the spine" {width: 360; height: 100; style.fill: "#EEF5E3"; style.stroke: "#5F9E00"; style.font-size: 16}
    pwr: "Busbar clip\n~50 V DC in from power shelves\n4 GPUs × 1.4 kW = 5.6 kW of GPU load" {width: 360; height: 100; style.fill: "#FBE6A2"; style.stroke: "#C98500"; style.font-size: 16}
    qd: "Liquid quick-disconnects\ncoolant supply + return\nfrom the rack manifold" {width: 360; height: 100; style.fill: "#E3EEF9"; style.stroke: "#256ABF"; style.font-size: 16}
  }

  boards: "MIDDLE - two superchip boards (cold plate on every GPU and CPU)" {
    style.fill: "#F7F7F4"
    style.stroke: "#52514E"
    style.font-size: 19
    grid-columns: 2
    grid-gap: 24

    sc1: "Superchip board A" {
      style.fill: "#FFFFFF"
      style.stroke: "#3F6B00"
      style.font-size: 17
      grid-rows: 2
      grid-gap: 10
      gpus1: "" {
        style.opacity: 0
        grid-columns: 2
        grid-gap: 10
        g1: "Blackwell Ultra GPU\n288 GB HBM3E\n~1.4 kW · cold plate" {width: 250; height: 110; style.fill: "#5F9E00"; style.font-color: "#FFFFFF"; style.stroke: "#3F6B00"; style.font-size: 16}
        g2: "Blackwell Ultra GPU\n288 GB HBM3E\n~1.4 kW · cold plate" {width: 250; height: 110; style.fill: "#5F9E00"; style.font-color: "#FFFFFF"; style.stroke: "#3F6B00"; style.font-size: 16}
      }
      cpu1: "Grace CPU · 72 Arm cores · ~480 GB LPDDR5X\nNVLink-C2C 900 GB/s to both GPUs (coherent)" {width: 520; height: 80; style.fill: "#F1EEFB"; style.stroke: "#6250D6"; style.font-size: 16}
    }
    sc2: "Superchip board B" {
      style.fill: "#FFFFFF"
      style.stroke: "#3F6B00"
      style.font-size: 17
      grid-rows: 2
      grid-gap: 10
      gpus2: "" {
        style.opacity: 0
        grid-columns: 2
        grid-gap: 10
        g3: "Blackwell Ultra GPU\n288 GB HBM3E\n~1.4 kW · cold plate" {width: 250; height: 110; style.fill: "#5F9E00"; style.font-color: "#FFFFFF"; style.stroke: "#3F6B00"; style.font-size: 16}
        g4: "Blackwell Ultra GPU\n288 GB HBM3E\n~1.4 kW · cold plate" {width: 250; height: 110; style.fill: "#5F9E00"; style.font-color: "#FFFFFF"; style.stroke: "#3F6B00"; style.font-size: 16}
      }
      cpu2: "Grace CPU · 72 Arm cores · ~480 GB LPDDR5X\nNVLink-C2C 900 GB/s to both GPUs (coherent)" {width: 520; height: 80; style.fill: "#F1EEFB"; style.stroke: "#6250D6"; style.font-size: 16}
    }
  }

  front: "FRONT EDGE - I/O and service side" {
    style.fill: "#F7F7F4"
    style.stroke: "#52514E"
    style.font-size: 19
    grid-columns: 4
    grid-gap: 12
    nic: "4 × ConnectX-8 SuperNIC\none per GPU, 800 Gb/s\nscale-out (east-west)" {width: 270; height: 100; style.fill: "#E3EEF9"; style.stroke: "#256ABF"; style.font-size: 16}
    dpu: "1 × BlueField-3 DPU\nstorage, tenancy, security\n(north-south)" {width: 270; height: 100; style.fill: "#E3EEF9"; style.stroke: "#256ABF"; style.font-size: 16}
    ssd: "Local NVMe SSDs\nscratch and OS" {width: 270; height: 100; style.fill: "#E8E7E2"; style.stroke: "#898781"; style.font-size: 16}
    bmc: "BMC + mgmt port\nout-of-band control,\nfirmware, telemetry" {width: 270; height: 100; style.fill: "#E8E7E2"; style.stroke: "#898781"; style.font-size: 16}
  }
}

vr: "Vera Rubin NVL72 tray (H2 2026): what changes" {
  style.fill: "#EEF5E3"
  style.stroke: "#5F9E00"
  style.font-size: 19
  grid-columns: 2
  grid-gap: 10
  v1: "2 Vera CPUs (88 custom Olympus cores, up to 1.5 TB LPDDR5X each)\n+ 4 Rubin GPUs (288 GB HBM4, ~1.8-2.3 kW reported)\nNVLink-C2C 1.8 TB/s · NVLink 6 at 3.0 TB/s per GPU (revised from 3.6)" {width: 640; height: 110; style.fill: "#FFFFFF"; style.stroke: "#5F9E00"; style.font-size: 16}
  v2: "ConnectX-9 SuperNICs (1.6 Tb/s per GPU) + BlueField-4 DPU\ncable-free, hose-free, fanless tray: 100% liquid cooled\nNVIDIA claims assembly in ~5 minutes vs ~2 hours" {width: 640; height: 110; style.fill: "#FFFFFF"; style.stroke: "#5F9E00"; style.font-size: 16}
}

tray -> vr: "" {style.stroke: "#FFFFFF"}
