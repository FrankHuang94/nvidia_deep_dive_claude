# Chapter 01: NVIDIA's four interlocking flywheels, joined at one hub (revenue and gross profit).
# Layout: 3x3 grid; the four loops sit in the corners, the hub in the centre. Each loop is a
# 2x2 grid read clockwise (top-left -> top-right -> bottom-right -> bottom-left -> back).

title: "Four flywheels, one hub: how NVIDIA's loops feed each other" {
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

grid-columns: 3
grid-gap: 120

dev: "① Developer / software loop" {
  style.fill: "#EEF5E3"
  style.stroke: "#5F9E00"
  style.font-size: 20
  grid-columns: 2
  grid-gap: 50
  d1: "1. Large installed\nbase of CUDA GPUs" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#5F9E00"; style.font-size: 16}
  d2: "2. More CUDA\ndevelopers + researchers" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#5F9E00"; style.font-size: 16}
  d4: "4. Best delivered\nperformance per \$" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#5F9E00"; style.font-size: 16}
  d3: "3. Libraries + papers\nland on CUDA first" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#5F9E00"; style.font-size: 16}
  d1 -> d2
  d2 -> d3
  d3 -> d4
  d4 -> d1
}

gap1: " " {style.opacity: 0; width: 60; height: 60}

scale: "② Scale / R&D loop" {
  style.fill: "#E3EEF9"
  style.stroke: "#2A78D6"
  style.font-size: 20
  grid-columns: 2
  grid-gap: 50
  s1: "1. R&D budget +\nsupply pre-commitments" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#2A78D6"; style.font-size: 16}
  s2: "2. Annual\narchitecture cadence" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#2A78D6"; style.font-size: 16}
  s4: "4. Pricing power +\nhigh gross margin" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#2A78D6"; style.font-size: 16}
  s3: "3. Performance lead\nat each launch" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#2A78D6"; style.font-size: 16}
  s1 -> s2
  s2 -> s3
  s3 -> s4
  s4 -> s1
}

gap2: " " {style.opacity: 0; width: 60; height: 60}

hub: "REVENUE +\nGROSS PROFIT\n\nthe shared hub" {
  shape: circle
  width: 250
  style.fill: "#5F9E00"
  style.font-color: "#FFFFFF"
  style.stroke: "#3F6B00"
  style.font-size: 22
  style.bold: true
}

gap3: " " {style.opacity: 0; width: 60; height: 60}

stack: "③ Full-stack / systems loop" {
  style.fill: "#F1EEFB"
  style.stroke: "#6250D6"
  style.font-size: 20
  grid-columns: 2
  grid-gap: 50
  f1: "1. Sell racks, NVLink,\nnetworking, software" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#6250D6"; style.font-size: 16}
  f2: "2. Higher share of\ndatacenter wallet" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#6250D6"; style.font-size: 16}
  f4: "4. Lower system\ncost per token" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#6250D6"; style.font-size: 16}
  f3: "3. Co-design across\nchip, link, rack, CUDA-X" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#6250D6"; style.font-size: 16}
  f1 -> f2
  f2 -> f3
  f3 -> f4
  f4 -> f1
}

gap4: " " {style.opacity: 0; width: 60; height: 60}

capital: "④ Capital / ecosystem loop" {
  style.fill: "#FBF1E1"
  style.stroke: "#C98500"
  style.font-size: 20
  grid-columns: 2
  grid-gap: 50
  c1: "1. Cash from\noperations" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#C98500"; style.font-size: 16}
  c2: "2. Stakes, backstops,\nprepayments" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#C98500"; style.font-size: 16}
  c4: "4. Ecosystem lock-in +\nsecured supply" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#C98500"; style.font-size: 16}
  c3: "3. Labs + neoclouds\norder more GPUs" {width: 220; style.fill: "#FFFFFF"; style.stroke: "#C98500"; style.font-size: 16}
  c1 -> c2
  c2 -> c3
  c3 -> c4
  c4 -> c1
}

# Every loop deposits into the hub or draws on it
dev -> hub: "units sold" {style.stroke: "#5F9E00"; style.stroke-width: 4; style.font-size: 16}
hub -> scale: "funds R&D + supply" {style.stroke: "#2A78D6"; style.stroke-width: 4; style.font-size: 16}
stack -> hub: "more \$ per GPU" {style.stroke: "#6250D6"; style.stroke-width: 4; style.font-size: 16}
hub -> capital: "cash to deploy" {style.stroke: "#C98500"; style.stroke-width: 4; style.font-size: 16}
